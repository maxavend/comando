<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comando.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Comando.Views"
    xmlns:models="using:Comando.Core.Models"
    SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="ExampleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFontFamily}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20,12,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="FolderText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnReveal" ToolTipService.ToolTip="Abrir en el Explorador de archivos" AutomationProperties.Name="Abrir en el Explorador de archivos">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnRestart" ToolTipService.ToolTip="Reiniciar la sesión" AutomationProperties.Name="Reiniciar la sesión">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ShellInfo"
            Grid.Row="1"
            Margin="20,0,20,8"
            IsClosable="False" />

        <ListView
            x:Name="EntryList"
            Grid.Row="2"
            Padding="20,0,20,8"
            SelectionMode="None"
            IsItemClickEnabled="False"
            AutomationProperties.Name="Mensajes">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CommandEntry">
                    <views:EntryView Entry="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty chat -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="420">
            <FontIcon Glyph="&#xE756;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="Escribe un comando para empezar"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Cada comando llega como un mensaje y su resultado como respuesta. Prueba con uno de estos:"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Style="{StaticResource ExampleButtonStyle}" Content="Get-ChildItem" Click="OnExample" />
                <Button Style="{StaticResource ExampleButtonStyle}" Content="git status" Click="OnExample" />
                <Button Style="{StaticResource ExampleButtonStyle}" Content="winget upgrade" Click="OnExample" />
            </StackPanel>
        </StackPanel>

        <!-- Composer -->
        <Grid Grid.Row="3" Padding="20,8,20,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Composer"
                PlaceholderText="Escribe un comando"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MaxHeight="180"
                MinHeight="36"
                Padding="14,8"
                CornerRadius="18"
                FontFamily="{StaticResource TerminalFontFamily}"
                FontSize="{StaticResource TerminalFontSize}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PreviewKeyDown="OnComposerKeyDown"
                AutomationProperties.Name="Comando" />
            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Bottom"
                CornerRadius="18"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSend"
                ToolTipService.ToolTip="Enviar (Entrar)"
                AutomationProperties.Name="Enviar">
                <FontIcon Glyph="&#xE724;" FontSize="14" />
            </Button>
            <Button
                x:Name="StopButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Bottom"
                CornerRadius="18"
                Visibility="Collapsed"
                Click="OnStop"
                ToolTipService.ToolTip="Detener (Ctrl+C)"
                AutomationProperties.Name="Detener">
                <FontIcon Glyph="&#xE71A;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
