<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comando.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Comando.Views"
    xmlns:models="using:Comando.Core.Models"
    SizeChanged="OnSizeChanged"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <UserControl.Resources>
        <!-- The one touch of color for the assistant: its progress bar. -->
        <LinearGradientBrush x:Key="AssistantProgressBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#4F8BFF" Offset="0" />
            <GradientStop Color="#A45CFF" Offset="0.35" />
            <GradientStop Color="#FF5CA8" Offset="0.65" />
            <GradientStop Color="#FFB547" Offset="1" />
        </LinearGradientBrush>
        <Storyboard x:Key="AssistantPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AssistantBar" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="ExampleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFontFamily}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <!-- Like a conversation header in Mensajes: avatar, name, detail, a divider. -->
        <Grid Padding="20,10,12,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" VerticalAlignment="Center">
                <Ellipse x:Name="AvatarFill" />
                <FontIcon x:Name="AvatarGlyph" FontSize="16" Foreground="White" />
                <TextBlock x:Name="AvatarEmoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="FolderText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnChangeFolder" ToolTipService.ToolTip="Ir a otra carpeta" AutomationProperties.Name="Ir a otra carpeta">
                    <FontIcon Glyph="&#xE8DA;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnReveal" ToolTipService.ToolTip="Abrir en el Explorador de archivos" AutomationProperties.Name="Abrir en el Explorador de archivos">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnRestart" ToolTipService.ToolTip="Reiniciar la sesión" AutomationProperties.Name="Reiniciar la sesión">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ShellInfo"
            Grid.Row="1"
            Margin="20,0,20,8"
            IsClosable="False" />

        <ListView
            x:Name="EntryList"
            Grid.Row="2"
            Padding="20,8,20,8"
            SelectionMode="None"
            IsItemClickEnabled="False"
            AutomationProperties.Name="Mensajes">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CommandEntry">
                    <views:EntryView Entry="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty chat -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="420">
            <FontIcon Glyph="&#xE756;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="Escribe un comando para empezar"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Cada comando llega como un mensaje y su resultado como respuesta. Prueba con uno de estos:"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Style="{StaticResource ExampleButtonStyle}" Content="Get-ChildItem" Click="OnExample" />
                <Button Style="{StaticResource ExampleButtonStyle}" Content="git status" Click="OnExample" />
                <Button Style="{StaticResource ExampleButtonStyle}" Content="winget upgrade" Click="OnExample" />
            </StackPanel>
        </StackPanel>

        <!-- Composer -->
        <Grid Grid.Row="3" Padding="20,8,20,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="AttachmentBar" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />

            <Grid Grid.Row="1">
                <TextBox
                    x:Name="Composer"
                    PlaceholderText="Escribe un comando"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="180"
                    MinHeight="40"
                    Padding="12,10,52,10"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    PreviewKeyDown="OnComposerKeyDown"
                    TextChanged="OnComposerTextChanged"
                    AutomationProperties.Name="Comando" />

                <!-- One action inside the field: Send, or Stop while something runs. -->
                <Button
                    x:Name="SendButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="0,0,6,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    CornerRadius="16"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="OnSend"
                    ToolTipService.ToolTip="Enviar (Entrar)"
                    AutomationProperties.Name="Enviar">
                    <FontIcon Glyph="&#xE725;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
                <Button
                    x:Name="StopButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="0,0,8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    CornerRadius="14"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed"
                    Click="OnStop"
                    ToolTipService.ToolTip="Detener (Ctrl+C)"
                    AutomationProperties.Name="Detener">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>

                <!-- While the assistant thinks, the field's underline takes its colors:
                     a bottom-only stroke on the field's own shape, so it curves into
                     the corners exactly like the native focus underline. -->
                <Border
                    x:Name="AssistantBar"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    BorderThickness="0,0,0,2"
                    BorderBrush="{StaticResource AssistantProgressBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />

                <!-- Fluent's indeterminate progress while a command runs, inside the corners. -->
                <ProgressBar
                    x:Name="ActivityBar"
                    IsIndeterminate="True"
                    VerticalAlignment="Bottom"
                    Margin="4,0,4,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    AutomationProperties.Name="En curso" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
