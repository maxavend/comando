<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comando.Views.SelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Comando.Views"
    xmlns:models="using:Comando.Core.Models">

    <!-- Shown in place of the chat when several sessions are chosen, like Mail
         with several messages: what they are, and what can be done with all. -->
    <StackPanel
        MaxWidth="460"
        Padding="40"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="18">

        <!-- Up to four avatars, overlapping like a stack. -->
        <ItemsControl x:Name="Avatars" HorizontalAlignment="Center" Margin="7,0" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TerminalSession">
                    <Grid Width="56" Height="56" Margin="-7,0">
                        <Ellipse Fill="{x:Bind views:Formatting.SessionBrush(ColorIndex)}" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="3" />
                        <FontIcon
                            Glyph="{x:Bind views:Formatting.SessionGlyph(Directory)}"
                            Visibility="{x:Bind views:Formatting.GlyphVisibility(Emoji)}"
                            FontSize="23"
                            Foreground="White" />
                        <TextBlock
                            Text="{x:Bind Emoji}"
                            FontSize="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                x:Name="Names"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button x:Name="ArchiveButton" Style="{StaticResource AccentButtonStyle}" Click="OnArchive">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ArchiveIcon" Glyph="&#xE7B8;" FontSize="16" />
                    <TextBlock x:Name="ArchiveLabel" Text="Archivar" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Click="OnDelete">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    <TextBlock Text="Eliminar…" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            x:Name="Hint"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
