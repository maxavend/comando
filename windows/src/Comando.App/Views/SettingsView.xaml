<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comando.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Cards in the style of the Windows Settings app. -->
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
        <Style x:Key="CardDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OnBack" ToolTipService.ToolTip="Volver al chat" AutomationProperties.Name="Volver al chat" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1" Text="Ajustes" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Spacing="4">

                <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,6" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="18" />
                    <TextBlock Grid.Column="1" Text="Tema" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="160" SelectionChanged="OnThemeChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="Como Windows" />
                        <ComboBoxItem Content="Claro" />
                        <ComboBoxItem Content="Oscuro" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D2;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tamaño de la letra" />
                        <TextBlock x:Name="FontPreview" Text="Get-ChildItem" FontFamily="{StaticResource TerminalFontFamily}" Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <Slider x:Name="FontSizeSlider" Grid.Column="2" Width="200" Minimum="11" Maximum="20" StepFrequency="1" ValueChanged="OnFontSizeChanged" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Notificaciones" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Avisar cuando un comando tarde más de" />
                        <TextBlock Text="Solo avisa si Comando no está al frente o estás en otra sesión." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="NotifyBox" Grid.Column="2" MinWidth="160" SelectionChanged="OnNotifyChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="5 segundos" Tag="5" />
                        <ComboBoxItem Content="10 segundos" Tag="10" />
                        <ComboBoxItem Content="30 segundos" Tag="30" />
                        <ComboBoxItem Content="1 minuto" Tag="60" />
                        <ComboBoxItem Content="5 minutos" Tag="300" />
                        <ComboBoxItem Content="Nunca" Tag="0" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="Asistente" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE945;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Entender pedidos con tus palabras" />
                        <TextBlock Text="Te propone comandos, recetas y herramientas, y responde tus preguntas. Usa Phi Silica, el modelo de Windows que corre en este PC. Nada se ejecuta sin que lo apruebes." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AssistantSwitch" Grid.Column="2" Toggled="OnAssistantToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE950;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Modelo en este PC" />
                        <TextBlock x:Name="ModelStatus" Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <Button x:Name="PrepareModelButton" Grid.Column="2" Content="Preparar" Click="OnPrepareModel" Visibility="Collapsed" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Buscar herramientas en internet" />
                        <TextBlock Text="Para sugerirte herramientas, busca en winget y npm con palabras clave. Solo salen las palabras de búsqueda, nunca tus archivos." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OnlineSwitch" Grid.Column="2" Toggled="OnOnlineToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>

                <TextBlock Text="Seguridad" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Pedir confirmación antes de comandos riesgosos" />
                        <TextBlock Text="Por ejemplo, borrar carpetas completas, ejecutar como administrador o descartar cambios de Git." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ConfirmSwitch" Grid.Column="2" Toggled="OnConfirmToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>

                <TextBlock Text="Agentes de IA" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Abrir los agentes de IA como chat" />
                        <TextBlock Text="Al escribir agy, claude, codex o qwen, sus respuestas llegan como mensajes. Desactívalo para usar su pantalla original." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AgentsSwitch" Grid.Column="2" Toggled="OnAgentsToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>

                <TextBlock Text="Terminal integrada" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE756;" FontSize="18" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Comandos que se abren en una terminal completa" />
                        <TextBlock Text="Los programas de pantalla completa, como vim o htop, se detectan solos." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <TextBox x:Name="InteractiveBox" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="False" FontFamily="{StaticResource TerminalFontFamily}" LostFocus="OnInteractiveChanged" />
                </Grid>

                <TextBlock Text="Acerca de" Style="{StaticResource SectionTitleStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/TitleBarIcon.png" Width="24" Height="24" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" />
                        <TextBlock Text="© 2026 Maximiliano Avendaño. Licencia MIT." Style="{StaticResource CardDetailStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Ver la bienvenida" Click="OnShowWelcome" />
                        <HyperlinkButton Content="Sitio web" NavigateUri="https://comando.maxav.com" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
