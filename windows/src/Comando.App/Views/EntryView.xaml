<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comando.Views.EntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    ActualThemeChanged="OnThemeChanged">

    <StackPanel Padding="0,8" Spacing="6">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Result">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Failed">
                    <VisualState.Setters>
                        <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="StatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- The command: what the person sent. -->
        <Border x:Name="CommandBubble" Style="{StaticResource CommandBubbleStyle}">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copiar comando" Click="OnCopyCommand">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ExplainItem" Text="Qué hace cada parte" Click="OnExplain">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Guardar como receta…" Click="OnSaveRecipe">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ejecutar de nuevo" Click="OnRunAgain">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
            <TextBlock
                x:Name="CommandText"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                FontFamily="{StaticResource TerminalFontFamily}"
                FontSize="{StaticResource TerminalFontSize}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
        </Border>

        <!-- The answer. -->
        <Border x:Name="OutputBubble" Style="{StaticResource OutputBubbleStyle}" Visibility="Collapsed">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copiar resultado" Click="OnCopyOutput">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel Spacing="6">
                <RichTextBlock
                    x:Name="OutputText"
                    FontSize="{StaticResource TerminalFontSize}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
                <HyperlinkButton x:Name="ShowAllButton" Padding="0" Visibility="Collapsed" Click="OnShowAll" />
            </StackPanel>
        </Border>

        <!-- The assistant's and the agents' answers. -->
        <Border x:Name="ReplyHost" Visibility="Collapsed" />

        <!-- Programs that draw their own screen get a real terminal. -->
        <Border x:Name="TerminalHost" Visibility="Collapsed" />

        <!-- How it went. -->
        <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
            <ProgressRing x:Name="RunningRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
            <FontIcon x:Name="StatusIcon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Why it failed, and what to try. -->
        <Border x:Name="HintHost" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
