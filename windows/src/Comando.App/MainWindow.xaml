<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Comando.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Comando.Views"
    xmlns:models="using:Comando.Core.Models"
    Title="Comando">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewSessionAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnClearAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="OnNextSessionAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="OnPreviousSessionAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnRecipesAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="I" Invoked="OnToolsAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Search lives in the title bar, as the Windows guidelines suggest. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Comando"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="260"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    PlaceholderText="Buscar en las sesiones"
                    QueryIcon="Find"
                    UpdateTextOnSelect="False"
                    TextChanged="OnSearchTextChanged"
                    SuggestionChosen="OnSearchSuggestionChosen"
                    QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="views:SearchResult">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource TerminalFontFamily}" />
                                <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Padding="8,0,8,8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Like Mensajes: the list's title with a compose button beside it,
                     and Seleccionar for checkboxes, as in Mail's list. -->
                <Grid Padding="12,4,4,0" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sesiones" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ToggleButton
                        x:Name="SelectButton"
                        Grid.Column="1"
                        Click="OnSelectClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,8"
                        ToolTipService.ToolTip="Seleccionar varias"
                        AutomationProperties.Name="Seleccionar varias">
                        <FontIcon Glyph="&#xE762;" FontSize="16" />
                    </ToggleButton>
                    <Button
                        Grid.Column="2"
                        Click="OnNewSession"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,8"
                        ToolTipService.ToolTip="Nueva sesión (Ctrl+N)"
                        AutomationProperties.Name="Nueva sesión">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="SessionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Controller.Sessions}"
                    SelectionMode="Extended"
                    SelectionChanged="OnSessionSelectionChanged"
                    AutomationProperties.Name="Sesiones">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TerminalSession">
                            <Grid Padding="4,10" ColumnSpacing="12" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Cambiar nombre…" Tag="{x:Bind}" Click="OnRenameSession">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Cambiar ícono y color…" Tag="{x:Bind}" Click="OnEditAppearance">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Fijar o quitar de arriba" Tag="{x:Bind}" Click="OnTogglePin">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Abrir en el Explorador de archivos" Tag="{x:Bind}" Click="OnRevealSession">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Borrar historial" Tag="{x:Bind}" Click="OnClearSession">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <!-- In a multiple selection, these two act on every chosen session. -->
                                        <MenuFlyoutItem Text="Archivar o desarchivar" Tag="{x:Bind}" Click="OnToggleArchive">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Eliminar sesión" Tag="{x:Bind}" Click="OnDeleteSession">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Grid Width="40" Height="40">
                                    <Ellipse Fill="{x:Bind views:Formatting.SessionBrush(ColorIndex), Mode=OneWay}" />
                                    <FontIcon
                                        Glyph="{x:Bind views:Formatting.SessionGlyph(Directory), Mode=OneWay}"
                                        Visibility="{x:Bind views:Formatting.GlyphVisibility(Emoji), Mode=OneWay}"
                                        FontSize="17"
                                        Foreground="White" />
                                    <TextBlock
                                        Text="{x:Bind Emoji, Mode=OneWay}"
                                        FontSize="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind views:Formatting.ArchivedOpacity(IsArchived), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind views:Formatting.LastCommand(LastCommand), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                </StackPanel>

                                <!-- Time on top, unread and pinned below, as in a messages list. -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind views:Formatting.ListTime(LastActivity), Mode=OneWay}"
                                        Style="{StaticResource MessageTimeStyle}"
                                        HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <FontIcon
                                            Glyph="&#xE840;"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Visibility="{x:Bind views:Formatting.VisibleIf(IsPinned), Mode=OneWay}" />
                                        <InfoBadge
                                            Value="{x:Bind UnreadCount, Mode=OneWay}"
                                            Visibility="{x:Bind views:Formatting.VisibleIfPositive(UnreadCount), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnShowTools" ToolTipService.ToolTip="Herramientas (Ctrl+Mayús+I)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" />
                            <TextBlock Text="Herramientas" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnShowRecipes" ToolTipService.ToolTip="Recetas (Ctrl+K)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE82D;" FontSize="16" />
                            <TextBlock Text="Recetas" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnShowSettings" ToolTipService.ToolTip="Ajustes (Ctrl+,)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Ajustes" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <views:ChatView x:Name="Chat" x:FieldModifier="public" />
                    <views:ToolsView x:Name="Tools" Visibility="Collapsed" />
                    <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                    <views:SelectionView x:Name="Selection" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
