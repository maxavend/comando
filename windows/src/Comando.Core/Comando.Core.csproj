    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Comando.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Comando.Core.Tests" />
  </ItemGroup>
</Project>
