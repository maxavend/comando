---
import Base from "@/layouts/base.astro"
import DotField from "@/components/dot-field.astro"
import Download from "@/components/download.astro"
import { LinkButton } from "@/components/link-button"
import { FeatureStage } from "@/components/feature-stage"
import { Shot } from "@/components/shot"
import { latestRelease, windowsRelease } from "@/lib/release"
import { repo, url } from "@/lib/site"

const release = await latestRelease()
const windows = await windowsRelease()
const img = (name: string) => url(`img/${name}.webp`)

const moments = [
  {
    id: "palabras",
    label: "Con tus palabras",
    title: "Pídelo con tus palabras",
    body: "El asistente propone el comando, te explica qué hace y espera tu clic.",
    shot: "renombrar",
    alt: "El pedido «Renombra todas las fotos como chiloe» y el comando que propone el asistente para renombrarlas sin reemplazar ninguna.",
  },
  {
    id: "agentes",
    label: "Agentes de IA",
    title: "Tus agentes, en burbujas",
    body: "Escribe <code>claude</code>, <code>codex</code>, <code>agy</code> o <code>qwen</code>. Sus permisos llegan como botones.",
    shot: "agente",
    alt: "Una conversación con Claude Code dentro de Comando: sus respuestas en burbujas y su pedido de permiso como un botón.",
  },
  {
    id: "recetas",
    label: "Recetas",
    title: "Recetas a un ⌘K",
    body: "Tareas comunes en lenguaje simple, y las tuyas, guardadas desde el chat.",
    shot: "recetas",
    alt: "El buscador de recetas sobre la ventana, con «espacio» escrito y dos resultados: ver qué ocupa más espacio aquí y ver el espacio en disco.",
  },
  {
    id: "programas",
    label: "Programas interactivos",
    title: "<code>vim</code>, <code>ssh</code> y Python, ahí mismo",
    body: "Los programas interactivos se abren en una terminal dentro del chat.",
    shot: "integrada",
    alt: "Python abierto en una terminal integrada dentro del chat, con un print y una suma.",
  },
]

const onWindows = [
  { title: "PowerShell 7", body: "Tu PowerShell y tu perfil, en burbujas. Si no lo tienes, Comando te ofrece instalarlo." },
  { title: "Phi Silica", body: "En los PC Copilot+, el asistente entiende lo que pides sin salir de tu equipo. En los demás responden la guía y las recetas." },
  {
    title: windows.version ? `Versión de prueba ${windows.version}` : "Versión de prueba",
    body: `Para Windows 10 y 11, en PC x64 o ARM64. <a class="underline decoration-border underline-offset-4 hover:decoration-primary" href="${url("instalar/#windows")}">Cómo abrirla</a>`,
  },
]

const needs = [
  { title: "macOS 27", body: "O posterior. Comando usa tu zsh y tu <code>~/.zshrc</code>." },
  { title: "Apple Intelligence", body: "Opcional, para el asistente. La guía responde aunque no esté activado." },
  {
    title: "Un clic de confianza",
    body: `La app no está notarizada: la primera vez, ábrela desde Privacidad y seguridad. <a class="underline decoration-border underline-offset-4 hover:decoration-primary" href="${url("instalar/")}">Ver los pasos</a>`,
  },
  {
    title: "Nada que pagar",
    body: `Código abierto con licencia MIT, en <a class="underline decoration-border underline-offset-4 hover:decoration-primary" href="${repo}">GitHub</a>.`,
  },
]
---

<Base
  title="Comando, la terminal para Mac que funciona como un chat"
  description="Una terminal para macOS donde cada comando es un mensaje y, si no sabes el comando, lo pides con tus palabras."
>
  <section class="landing-hero relative isolate grid min-h-[calc(100dvh-var(--nav-height))] items-center py-10 max-lg:min-h-0 max-lg:pt-16">
    <DotField />
    <div class="page grid items-center gap-10 lg:grid-cols-[minmax(0,9fr)_minmax(0,16fr)] lg:max-xl:grid-cols-2">
      <div class="t-stagger" data-hero-reveal>
        <p class="hero-eyebrow t-stagger-line" data-enter style="--i: 0">Una terminal hecha para conversar</p>
        <h1 class="hero-conversation t-stagger-line" data-enter style="--i: 1">
          <span class="sr-only">Tu terminal, como un chat. Pídelo con tus palabras.</span>
          <span class="hero-terminal" aria-hidden="true">
            <span class="hero-type-line"><span class="hero-type-space">Tu terminal,</span><span class="hero-type-ink"><span data-hero-line>Tu terminal,</span><span class="hero-caret"></span></span></span>
            <span class="hero-type-line"><span class="hero-type-space">como un chat.</span><span class="hero-type-ink"><span data-hero-line>como un chat.</span><span class="hero-caret"></span></span></span>
          </span>
          <span class="hero-reply" aria-hidden="true">
            <span class="hero-typing"><span class="hero-dots"><i></i><i></i><i></i></span></span>
            <span class="hero-bubble">Pídelo con tus palabras.</span>
          </span>
        </h1>
        <p class="hero-lead mt-6 max-w-[34ch] text-lead text-ink-2 t-stagger-line t-stagger-line--2" data-enter style="--i: 2">Dile qué necesitas hacer. Comando te propone cómo, te lo explica y espera tu clic.</p>
        <div class="t-stagger-line t-stagger-line--3" data-enter style="--i: 2">
        <Download class="mt-10" note="Gratis y de código abierto. Para macOS 27." />
        </div>
      </div>
      <div data-enter style="--i: 3">
      <Shot
        client:visible
        light={img("asistente-claro")}
        dark={img("asistente-oscuro")}
        srcSet={{
          light: `${img("asistente-claro")} 1600w, ${img("asistente-claro-2x")} 2200w`,
          dark: `${img("asistente-oscuro")} 1600w, ${img("asistente-oscuro-2x")} 2200w`,
        }}
        sizes="(min-width: 60rem) 58vw, 100vw"
        priority
        alt="Comando: el pedido «Comprime el audio de la entrevista» y la respuesta del asistente, que propone un comando afconvert con los botones Ejecutar y Editar."
      />
      </div>
    </div>
  </section>

  <section aria-labelledby="antes" class="pt-36 max-lg:pt-24 max-sm:pt-18">
    <div class="page">
      <h2 id="antes" class="display mb-16 max-w-[30ch] text-section max-sm:mb-8">Antes de borrar, te pregunta.</h2>
      <div class="grid items-start gap-8 lg:grid-cols-2 max-sm:gap-10">
        <div>
          <h3 class="display mb-4 text-title">En la Terminal</h3>
          <div class="tray grid aspect-[1600/1048] content-start rounded-[14px] p-10 max-sm:aspect-auto max-sm:p-6">
            <pre class="font-mono text-[clamp(1rem,0.6vw+0.8rem,1.25rem)] leading-[1.7] whitespace-pre-wrap"><span class="text-muted-foreground">%</span> ls Respaldos
2023    2024
<span class="text-muted-foreground">%</span> rm -rf Respaldos/2023
<span class="text-muted-foreground">%</span> ls Respaldos
2024
<span class="text-muted-foreground">%</span></pre>
          </div>
          <p class="mt-4 max-w-[46ch] text-ink-2">La carpeta desaparece. Sin aviso y sin pasar por la Papelera.</p>
        </div>
        <div>
          <h3 class="display mb-4 text-title">En Comando</h3>
          <Shot
            client:visible
            light={img("borrar-claro")}
            dark={img("borrar-oscuro")}
            alt="Aviso de Comando: «Este comando borra archivos de forma permanente», con los botones Mover a la Papelera, Eliminar para siempre y Cancelar."
          />
          <p class="mt-4 max-w-[46ch] text-ink-2">Te explica qué va a pasar y te ofrece la Papelera.</p>
        </div>
      </div>
    </div>
  </section>

  <FeatureStage
    client:idle
    heading="Escribe, pide o delega."
    lead="Con tu zsh y tu configuración de siempre."
    items={moments.map((m) => ({ ...m, light: img(`${m.shot}-claro`), dark: img(`${m.shot}-oscuro`) }))}
  />

  <section aria-label="Privacidad" class="bg-band py-30 text-band-foreground max-lg:py-20 max-sm:py-14">
    <div class="page">
      <p class="display max-w-[22ch] text-display-s">Lo que le pides se queda en tu Mac.</p>
      <p class="mt-6 max-w-[48ch] text-lead text-band-muted">
        Apple Intelligence responde en tu equipo y nada se ejecuta sin tu clic.{" "}
        <a class="text-band-foreground underline decoration-band-border underline-offset-4 hover:decoration-band-foreground" href={url("privacidad/")}>Cómo funciona</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="windows" class="pt-36 max-lg:pt-24 max-sm:pt-18">
    <div class="page grid items-center gap-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-lg:gap-10">
      <div>
        <h2 id="windows" class="display max-w-[16ch] text-section">También para Windows.</h2>
        <p class="mt-6 max-w-[40ch] text-lead text-ink-2">El mismo chat de comandos, hecho con las piezas de Windows 11.</p>
        <dl class="mt-10 border-t">
          {
            onWindows.map((n) => (
              <div class="grid gap-1 border-b py-5">
                <dt class="font-heading text-lg font-semibold">{n.title}</dt>
                <dd class="max-w-[48ch] text-ink-2" set:html={n.body} />
              </div>
            ))
          }
        </dl>
        <div class="download-stack mt-10 flex flex-col items-start gap-3">
          <LinkButton href={windows.x64} size="xl" download>Descargar para Windows</LinkButton>
          <p class="text-sm text-muted-foreground">
            x64, para la mayoría de los PC. ¿Tu PC tiene Snapdragon?{" "}
            <a class="text-ink-2 underline decoration-border underline-offset-4 hover:text-foreground hover:decoration-primary" href={windows.arm64}>Descarga ARM64</a>.
          </p>
        </div>
      </div>
      <Shot
        client:visible
        light={img("windows-chat")}
        width={1084}
        height={711}
        alt="Comando en Windows: la lista de sesiones a la izquierda, un comando de PowerShell con su resultado y la pregunta «para qué sirve Comando» respondida por la guía."
      />
    </div>
  </section>

  <section aria-labelledby="requisitos" class="pt-36 max-lg:pt-24 max-sm:pt-18">
    <div class="page grid items-start gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <h2 id="requisitos" class="display max-w-[30ch] text-section">Solo necesitas tu Mac</h2>
      <dl class="border-t">
        {
          needs.map((n) => (
            <div class="grid items-baseline gap-8 border-b py-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-lg:gap-2">
              <dt class="display text-title">{n.title}</dt>
              <dd class="max-w-[48ch] text-ink-2" set:html={n.body} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section aria-labelledby="cierre" class="pt-36 pb-16 max-lg:pt-24 max-sm:pt-18">
    <div class="page">
      <div class="download-card grid items-center gap-16 rounded-[20px] bg-band p-16 text-band-foreground lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-lg:gap-10 max-lg:px-6 max-lg:py-10">
        <div>
          <h2 id="cierre" class="display text-section">Empieza con un <code>ls</code>.</h2>
          <p class="mt-4 text-lead text-band-muted">O pregúntale «¿para qué sirve?».</p>
          <Download class="mt-10" note={release.note} onBand />
        </div>
        <Shot
          client:visible
          onBand
          light={img("chat-oscuro")}
          alt="Comando en modo oscuro con git status y git log en burbujas, y la barra lateral con varias sesiones."
        />
      </div>
    </div>
  </section>
  <noscript><style>.t-stagger-line { opacity: 1; transform: none; filter: none; }</style></noscript>
  <script>
    const block = document.querySelector<HTMLElement>("[data-hero-reveal]")
    const hero = document.querySelector<HTMLElement>(".hero-conversation")
    const lines = [...document.querySelectorAll<HTMLElement>("[data-hero-line]")]
    const motion = matchMedia("(prefers-reduced-motion: reduce)")

    if (block && hero && lines.length === 2) {
      const phrases = lines.map((line) => line.textContent ?? "")
      let frame = 0
      let elapsed = 0
      let previous = 0
      let visible = true
      let finished = false
      const startDelay = 320
      const characterTime = 48
      const linePause = 160
      const typedAt = startDelay + phrases.join("").length * characterTime + linePause
      const thinkingAt = typedAt + 280
      const sentAt = thinkingAt + 2200
      const completeAt = sentAt + 180

      const finish = () => {
        finished = true
        cancelAnimationFrame(frame)
        phrases.forEach((phrase, i) => { lines[i].textContent = phrase })
        hero.dataset.phase = "sent"
        hero.dataset.cursor = "1"
        hero.setAttribute("data-holding", "")
        motion.removeEventListener("change", onMotionChange)
      }
      const tick = (now: number) => {
        elapsed += previous ? Math.min(now - previous, 64) : 0
        previous = now
        const count = Math.max(0, Math.floor((elapsed - startDelay) / characterTime))
        const firstLength = phrases[0].length
        const secondCount = Math.max(0, Math.floor((elapsed - startDelay - firstLength * characterTime - linePause) / characterTime))
        const values = [phrases[0].slice(0, count), phrases[1].slice(0, secondCount)]
        values.forEach((value, i) => { if (lines[i].textContent !== value) lines[i].textContent = value })
        const cursor = count < firstLength ? "0" : "1"
        if (hero.dataset.cursor !== cursor) hero.dataset.cursor = cursor
        hero.toggleAttribute("data-holding", elapsed >= typedAt)
        if (elapsed >= completeAt) return finish()
        const phase = elapsed >= sentAt ? "sent" : elapsed >= thinkingAt ? "thinking" : "typing"
        if (hero.dataset.phase !== phase) hero.dataset.phase = phase
        frame = requestAnimationFrame(tick)
      }
      const syncPlayback = () => {
        cancelAnimationFrame(frame)
        previous = 0
        const paused = !visible || document.hidden
        hero.toggleAttribute("data-paused", paused)
        if (!finished && !paused) frame = requestAnimationFrame(tick)
      }
      const onMotionChange = () => { if (motion.matches) finish() }
      const onVisibilityChange = () => syncPlayback()
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting
        syncPlayback()
      })

      // Keep complete server-rendered copy until fonts are ready. Layout is
      // reserved by the full lines, so typing never moves the CTA or screenshot.
      document.fonts.ready.then(() => {
        block.classList.add("is-shown")
        if (motion.matches) return finish()
        hero.dataset.phase = "typing"
        hero.dataset.cursor = "0"
        lines.forEach((line) => { line.textContent = "" })
        motion.addEventListener("change", onMotionChange)
        document.addEventListener("visibilitychange", onVisibilityChange)
        observer.observe(hero)
      })
    }
  </script>
</Base>
