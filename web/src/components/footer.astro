---
import { Separator } from "@/components/ui/separator"
import { latestRelease } from "@/lib/release"
import { repo, url } from "@/lib/site"

const release = await latestRelease()

const columns = [
  {
    title: "Producto",
    links: [
      { href: release.href, label: "Descargar" },
      { href: url("instalar/"), label: "Instalar" },
      { href: url("novedades/"), label: "Novedades" },
      { href: url("atajos/"), label: "Atajos" },
    ],
  },
  {
    title: "Proyecto",
    links: [
      { href: repo, label: "Código en GitHub" },
      { href: `${repo}/issues/new?template=error.yml`, label: "Reportar un error" },
      { href: `${repo}/issues/new?template=idea.yml`, label: "Proponer una idea" },
      { href: `${repo}/releases`, label: "Todas las versiones" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: url("privacidad/"), label: "Privacidad" },
      { href: url("legal/"), label: "Licencia y créditos" },
      { href: `${url("legal/")}#marcas`, label: "Marcas" },
    ],
  },
]
---

<footer class="relative overflow-clip border-t pt-24 max-lg:pt-16">
  <div class="page">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-lg:gap-12">
      <div>
        <a href={url()} aria-label="Comando, inicio" class="inline-flex items-center gap-2.5 rounded-full font-heading text-xl leading-none font-bold tracking-tight">
          <img src={url("img/logo.svg")} width="34" height="35" alt="" />
          Comando
        </a>
        <p class="mt-8 max-w-[40ch] text-lead text-ink-2">
          Un proyecto personal y abierto. Si algo falla o se te ocurre una idea, cuéntamelo en GitHub.
        </p>
      </div>

      <nav aria-label="Pie de página" class="grid grid-cols-3 gap-8 max-sm:grid-cols-2 max-sm:gap-x-4 max-sm:gap-y-8">
        {
          columns.map((column) => (
            <div>
              <h2 class="text-sm text-muted-foreground">{column.title}</h2>
              <ul class="mt-4 grid gap-1">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="-mx-2 inline-flex min-h-11 items-center rounded-lg px-2 text-ink-2 transition-colors duration-200 hover:bg-glass-hover hover:text-foreground focus-visible:outline-offset-0 active:bg-glass-press"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <Separator className="mt-20 max-lg:mt-14" />
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-sm text-muted-foreground">
      <p>© 2026 Maximiliano Avendaño. Código abierto con licencia MIT.</p>
      <p>{release.version ? `Versión ${release.version}, para macOS 27` : "Para macOS 27"}</p>
    </div>
  </div>

  <p
    aria-hidden="true"
    class="display pointer-events-none -mb-[0.22em] text-center text-[clamp(3rem,19vw,17rem)] leading-none whitespace-nowrap tracking-[-0.055em] text-foreground/[0.07] select-none"
  >
    Comando
  </p>
</footer>
