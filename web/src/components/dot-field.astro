---
// A faint grid of dots behind the hero. A wide, faint glow of blue dots
// drifts slowly across it; under the cursor a brighter spotlight follows
// the pointer. Pure CSS: the script only moves the spotlight's centre.
---

<div data-dot-field aria-hidden="true" class="dot-field pointer-events-none absolute inset-0 -z-10"></div>

<script>
  const field = document.querySelector<HTMLElement>("[data-dot-field]")
  const hero = field?.parentElement
  // The slow drift rests while the hero is off screen.
  if (field) {
    new IntersectionObserver(([e]) => field.toggleAttribute("data-paused", !e.isIntersecting)).observe(field)
  }
  if (field && hero && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let frame = 0
    let x = 0
    let y = 0
    hero.addEventListener("pointermove", (e) => {
      const rect = field.getBoundingClientRect()
      x = e.clientX - rect.left
      y = e.clientY - rect.top
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        field.style.setProperty("--x", x + "px")
        field.style.setProperty("--y", y + "px")
        field.dataset.lit = ""
      })
    })
    hero.addEventListener("pointerleave", () => delete field.dataset.lit)
  }
</script>
